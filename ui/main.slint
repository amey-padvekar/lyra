// A circular, hover-highlighted icon button. Children are slotted in centred,
// so each call site only supplies the glyph itself.
component ControlButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover && root.enabled ? rgba(255, 255, 255, 0.10) : transparent;
    opacity: root.enabled ? 1.0 : 0.28;

    animate background {
        duration: 120ms;
        easing: ease-out;
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    // `preferred-*` rather than `width`/`height`: setting those pins min == max,
    // which the winit backend reads as "not resizable".
    preferred-width: 420px;
    preferred-height: 264px;
    min-width: 300px;
    min-height: 200px;
    title: "Lyra";
    always-on-top: true;
    no-frame: true;
    // A frameless window has no OS-drawn edge to grab, so carve out our own
    // hit-test margin. Presses inside it are consumed by the backend before
    // reaching the item tree, so this doesn't fight `drag-area` below.
    resize-border-width: 6px;
    // Window itself stays fully transparent so `card` below can show through
    // with rounded corners — a squared `background` on Window would fill the
    // whole rectangular surface and clip off the rounding.
    background: transparent;

    in property <string> track-title;
    in property <string> track-artist;
    in property <string> current-line;
    in property <string> elapsed-label;
    in property <string> total-label;
    in property <image> album-cover;
    in property <bool> has-album-cover: false;
    // 0.0 - 1.0 fraction of the track that's played so far.
    in property <float> progress;
    // Driven from Rust: dipped to 0 then back to 1 around a line change, so
    // the transition crossfades instead of snapping.
    in property <float> line-opacity: 1.0;
    in property <bool> is-playing;
    in property <bool> can-play-pause;
    in property <bool> can-next;
    in property <bool> can-previous;

    callback drag-window(length, length);
    callback toggle-play-pause();
    callback skip-next();
    callback skip-previous();
    callback hide-overlay();

    // Declared before `card` so it sits *below* it. The control buttons'
    // TouchAreas then take input priority, while clicks anywhere inert
    // (text, background) fall through to here and drag the window.
    drag-area := TouchArea {
        moved => {
            if (drag-area.pressed) {
                root.drag-window(drag-area.mouse-x - drag-area.pressed-x, drag-area.mouse-y - drag-area.pressed-y);
            }
        }
    }

    card := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 18px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.09);
        background: @linear-gradient(135deg, rgba(30, 30, 36, 0.90) 0%, rgba(12, 12, 16, 0.92) 100%);

        VerticalLayout {
            padding: 20px;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 76px;
                    height: 76px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.16);
                    background: rgba(255, 255, 255, 0.04);

                    if has-album-cover: Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: album-cover;
                    }

                    if !has-album-cover: Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        // Stylised music note as an album-art placeholder.
                        commands: "M 64 16 L 64 58 C 60 54, 52 52, 45 52 C 33 52, 24 60, 24 71 C 24 82, 33 90, 45 90 C 58 90, 67 82, 67 71 L 67 36 L 84 31 L 84 66 C 80 62, 72 60, 65 60 C 53 60, 44 68, 44 79 C 44 90, 53 98, 65 98 C 78 98, 87 90, 87 79 L 87 16 Z";
                        fill: rgba(245, 245, 247, 0.76);
                    }
                }
            }

            Text {
                text: track-title;
                color: #f5f5f7;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: track-artist;
                color: #9a9aa5;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: current-line;
                color: #e8e8ec;
                font-size: 16px;
                horizontal-alignment: center;
                // Sole stretchy row, so growing the window gives the lyric the
                // extra height instead of padding the gaps everywhere.
                vertical-stretch: 1;
                vertical-alignment: center;
                wrap: word-wrap;
                opacity: line-opacity;
                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }
            }

            Rectangle {
                height: 5px;
                background: rgba(255, 255, 255, 0.10);
                border-radius: 2.5px;

                Rectangle {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    width: parent.width * progress;
                    background: @linear-gradient(90deg, #1ed760 0%, #17a34a 100%);
                    border-radius: 2.5px;
                }
            }

            HorizontalLayout {
                Text {
                    text: elapsed-label;
                    color: #8b8b95;
                    font-size: 11px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: total-label;
                    color: #8b8b95;
                    font-size: 11px;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                ControlButton {
                    enabled: can-previous;
                    clicked => {
                        root.skip-previous();
                    }
                    // Left-pointing triangle against a bar.
                    Path {
                        width: 15px;
                        height: 15px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 80 18 L 38 50 L 80 82 Z M 20 18 L 32 18 L 32 82 L 20 82 Z";
                        fill: #e8e8ec;
                    }
                }

                ControlButton {
                    enabled: can-play-pause;
                    clicked => {
                        root.toggle-play-pause();
                    }
                    // `if` rather than `visible`, so the hidden glyph is out of
                    // the tree entirely and can't skew the centring.
                    if !is-playing: Path {
                        width: 16px;
                        height: 16px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 26 14 L 84 50 L 26 86 Z";
                        fill: #f5f5f7;
                    }
                    if is-playing: HorizontalLayout {
                        spacing: 5px;
                        Rectangle {
                            width: 5px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: #f5f5f7;
                        }
                        Rectangle {
                            width: 5px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: #f5f5f7;
                        }
                    }
                }

                ControlButton {
                    enabled: can-next;
                    clicked => {
                        root.skip-next();
                    }
                    // Right-pointing triangle against a bar.
                    Path {
                        width: 15px;
                        height: 15px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 20 18 L 62 50 L 20 82 Z M 68 18 L 80 18 L 80 82 L 68 82 Z";
                        fill: #e8e8ec;
                    }
                }
            }
        }

        // Declared after the layout so it draws on top and wins the click.
        // Hides to the tray rather than quitting — the tray menu owns Quit.
        close-button := Rectangle {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: close-touch.has-hover ? rgba(232, 76, 76, 0.90) : rgba(255, 255, 255, 0.05);

            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Path {
                width: 10px;
                height: 10px;
                // Viewbox matched 1:1 to the pixel size, so `stroke-width`
                // means what it says instead of being scaled by the viewbox.
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                stroke: close-touch.has-hover ? #ffffff : #9a9aa5;
                stroke-width: 1.5px;
                stroke-line-cap: round;
            }

            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.hide-overlay();
                }
            }
        }
    }
}
