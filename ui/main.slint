// A circular, hover-highlighted icon button. Children are slotted in centred,
// so each call site only supplies the glyph itself.
component ControlButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover && root.enabled ? rgba(255, 255, 255, 0.10) : transparent;
    opacity: root.enabled ? 1.0 : 0.28;

    animate background {
        duration: 120ms;
        easing: ease-out;
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Type scale and spacing for the two-line lyric stack. Shared between
// `LyricRow` and the sizing probe in `MainWindow` so the probe always
// measures at exactly the size the current row renders at — a row that sets
// its own `font-size`, `font-weight` or `font-family` would measure short.
global LyricStyle {
    out property <length> current-size: 16px;
    out property <length> next-size: 12px;
    // Space between the bottom of the current line and the top of the next.
    out property <length> gap: 6px;
    // How far below its resting place a row parks while "entering".
    out property <length> enter-drop: 26px;
}

// One row of the two-line lyric display. `role` places and styles it:
// 0 = current line (bright, larger, at rest), 1 = next line (dim, smaller,
// at rest below it), 2 = "entering" — parked further below and fully
// transparent, used only as the instant, invisible starting point right
// after a row is handed new text, so it has somewhere to animate up *from*.
// `instant`, driven from Rust, collapses the transition to 0ms for exactly
// that hidden hand-off; every other transition animates normally, which is
// what turns role 2 -> 1 into the "next line rises into view" motion and
// role 1 -> 0 into the "next line becomes current" motion.
//
// `stack-offset` is where role 1 comes to rest. It's measured and passed down
// by the parent rather than fixed here, because the current line wraps to two
// visual lines often enough that a constant offset would leave the next line
// drawn on top of the current line's second row.
component LyricRow inherits Text {
    in property <int> role;
    in property <bool> instant;
    in property <length> stack-offset;

    horizontal-alignment: center;
    wrap: word-wrap;
    width: 100%;
    color: role == 0 ? #e8e8ec : #7a7a85;
    font-size: role == 0 ? LyricStyle.current-size : LyricStyle.next-size;
    y: role == 0 ? 0px : (role == 1 ? stack-offset : stack-offset + LyricStyle.enter-drop);
    opacity: role == 0 ? 1.0 : (role == 1 ? 0.65 : 0.0);

    animate color, font-size, y, opacity {
        duration: instant ? 0ms : 260ms;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
}

export component MainWindow inherits Window {
    // `preferred-*` rather than `width`/`height`: setting those pins min == max,
    // which the winit backend reads as "not resizable".
    preferred-width: 420px;
    preferred-height: 264px;
    min-width: 300px;
    min-height: 200px;
    title: "Lyra";
    always-on-top: true;
    no-frame: true;
    // A frameless window has no OS-drawn edge to grab, so carve out our own
    // hit-test margin. Presses inside it are consumed by the backend before
    // reaching the item tree, so this doesn't fight `drag-area` below.
    resize-border-width: 6px;
    // Window itself stays fully transparent so `card` below can show through
    // with rounded corners — a squared `background` on Window would fill the
    // whole rectangular surface and clip off the rounding.
    background: transparent;

    in property <string> track-title;
    in property <string> track-artist;
    in property <string> elapsed-label;
    in property <string> total-label;
    // 0.0 - 1.0 fraction of the track that's played so far.
    in property <float> progress;
    // The two visible lyric rows. Which text is "current" vs "next" isn't
    // fixed to slot A or B — Rust flips which slot plays which role each
    // time the line advances, so a row can animate smoothly from "next" into
    // "current" without its text ever changing mid-transition. See
    // `LyricRow` above and `app.rs`'s `promote_and_advance`/`snap_lyric_rows`.
    in property <string> line-a-text;
    in property <string> line-b-text;
    in property <int> line-a-role: 0;
    in property <int> line-b-role: 1;
    in property <bool> line-a-instant;
    in property <bool> line-b-instant;
    in property <bool> is-playing;
    in property <bool> can-play-pause;
    in property <bool> can-next;
    in property <bool> can-previous;
    in property <bool> can-seek;

    callback drag-window(length, length);
    callback toggle-play-pause();
    callback skip-next();
    callback skip-previous();
    callback hide-overlay();
    /// Where on the track the user clicked, as a 0.0-1.0 fraction. Deliberately
    /// not a position in ms: the track duration lives on the Rust side, and
    /// this way the UI never has to hold a second copy of it.
    callback seek(float);

    // Declared before `card` so it sits *below* it. The control buttons'
    // TouchAreas then take input priority, while clicks anywhere inert
    // (text, background) fall through to here and drag the window.
    // `mouse-cursor: default` prevents the OS spinning-wait cursor that appears
    // when a window captures events but its cursor style is unspecified.
    drag-area := TouchArea {
        mouse-cursor: default;
        moved => {
            if (drag-area.pressed) {
                root.drag-window(drag-area.mouse-x - drag-area.pressed-x, drag-area.mouse-y - drag-area.pressed-y);
            }
        }
    }

    card := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 18px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.09);
        background: @linear-gradient(135deg, rgba(30, 30, 36, 0.90) 0%, rgba(12, 12, 16, 0.92) 100%);

        VerticalLayout {
            padding: 20px;
            spacing: 8px;

            Text {
                text: track-title;
                color: #f5f5f7;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: track-artist;
                color: #9a9aa5;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Rectangle {
                clip: true;
                // Sole stretchy row, so growing the window gives the lyrics
                // extra height instead of padding the gaps everywhere.
                // `min-height` covers a single-line current line plus the next
                // one below it; a current line that wraps needs more, which the
                // stretch supplies at anything near the preferred window size.
                min-height: 60px;
                vertical-stretch: 1;

                // Invisible ruler, not a third visible row: it holds whichever
                // text is currently the *current* line, always at the current
                // line's font size, so its `height` is that line's real wrapped
                // height and the next row can be parked clear of it.
                //
                // Measured here instead of read off `lineA`/`lineB` directly
                // because the promoted row's `font-size` animates 12px -> 16px
                // over 260ms: its height — and so the offset — would still be
                // growing, and the next row, easing toward a moving target,
                // would lag *above* its true position and cut into the current
                // line for the length of the transition. The probe reports the
                // settled height on the very first frame instead.
                //
                // `opacity: 0` rather than `visible: false`: the latter is
                // lowered into a synthetic Clip wrapper, which would change
                // what this element's `width: 100%` resolves against.
                current-probe := Text {
                    text: line-a-role == 0 ? line-a-text : line-b-text;
                    font-size: LyricStyle.current-size;
                    wrap: word-wrap;
                    width: 100%;
                    y: 0;
                    opacity: 0;
                }

                lineA := LyricRow {
                    text: line-a-text;
                    role: line-a-role;
                    instant: line-a-instant;
                    stack-offset: current-probe.height + LyricStyle.gap;
                }
                lineB := LyricRow {
                    text: line-b-text;
                    role: line-b-role;
                    instant: line-b-instant;
                    stack-offset: current-probe.height + LyricStyle.gap;
                }
            }

            // The visible track stays thin, but the row it sits in is taller so
            // there is something to actually hit — a 5px target is a coin flip
            // with a trackpad, and `seek-touch` fills the whole row.
            Rectangle {
                height: 14px;

                seek-touch := TouchArea {
                    enabled: can-seek;
                    mouse-cursor: pointer;
                    clicked => {
                        root.seek(clamp(seek-touch.mouse-x / seek-touch.width, 0.0, 1.0));
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    // Thickens on hover, which is the only affordance saying the
                    // bar is interactive at all on a source that allows seeking.
                    height: seek-touch.has-hover && can-seek ? 7px : 5px;
                    border-radius: self.height / 2;
                    background: rgba(255, 255, 255, 0.10);

                    animate height {
                        duration: 120ms;
                        easing: ease-out;
                    }

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * progress;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: @linear-gradient(90deg, #1ed760 0%, #17a34a 100%);
                    }
                }
            }

            HorizontalLayout {
                Text {
                    text: elapsed-label;
                    color: #8b8b95;
                    font-size: 11px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: total-label;
                    color: #8b8b95;
                    font-size: 11px;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                ControlButton {
                    enabled: can-previous;
                    clicked => {
                        root.skip-previous();
                    }
                    // Left-pointing triangle against a bar.
                    Path {
                        width: 15px;
                        height: 15px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 80 18 L 38 50 L 80 82 Z M 20 18 L 32 18 L 32 82 L 20 82 Z";
                        fill: #e8e8ec;
                    }
                }

                ControlButton {
                    enabled: can-play-pause;
                    clicked => {
                        root.toggle-play-pause();
                    }
                    // `if` rather than `visible`, so the hidden glyph is out of
                    // the tree entirely and can't skew the centring.
                    if !is-playing: Path {
                        width: 16px;
                        height: 16px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 26 14 L 84 50 L 26 86 Z";
                        fill: #f5f5f7;
                    }
                    if is-playing: HorizontalLayout {
                        spacing: 5px;
                        Rectangle {
                            width: 5px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: #f5f5f7;
                        }
                        Rectangle {
                            width: 5px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: #f5f5f7;
                        }
                    }
                }

                ControlButton {
                    enabled: can-next;
                    clicked => {
                        root.skip-next();
                    }
                    // Right-pointing triangle against a bar.
                    Path {
                        width: 15px;
                        height: 15px;
                        viewbox-width: 100;
                        viewbox-height: 100;
                        commands: "M 20 18 L 62 50 L 20 82 Z M 68 18 L 80 18 L 80 82 L 68 82 Z";
                        fill: #e8e8ec;
                    }
                }
            }
        }

        // Declared after the layout so it draws on top and wins the click.
        // Close hides to tray/menu-bar; quit lives in that menu.
        close-button := Rectangle {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: close-touch.has-hover ? rgba(232, 76, 76, 0.90) : rgba(255, 255, 255, 0.05);

            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Path {
                width: 10px;
                height: 10px;
                // Viewbox matched 1:1 to the pixel size, so `stroke-width`
                // means what it says instead of being scaled by the viewbox.
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                stroke: close-touch.has-hover ? #ffffff : #9a9aa5;
                stroke-width: 1.5px;
                stroke-line-cap: round;
            }

            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.hide-overlay();
                }
            }
        }
    }
}
